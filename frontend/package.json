{
  "name": "stellar-k8s-topology-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "WebGL network quorum topology visualizer for Stellar-K8s",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "compile:tests": "esbuild src/topology/types.ts src/topology/parser.ts src/topology/graph.ts src/topology/layout.ts --outdir=tests/compiled --format=esm --target=es2022",
    "pretest": "npm run compile:tests",
    "test": "node --test tests/unit/*.test.mjs tests/bench/*.test.mjs",
    "bench": "npm run compile:tests && node tests/bench/run_benchmark.mjs",
    "bench:fast": "npm run compile:tests && node tests/bench/run_benchmark.mjs --quick"
  },
  "dependencies": {
    "three": "^0.171.0",
    "d3-force-3d": "^3.0.0",
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "@types/d3-scale": "^4.0.8",
    "@types/three": "^0.171.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}

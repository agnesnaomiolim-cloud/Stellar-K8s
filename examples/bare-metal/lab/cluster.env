# examples/bare-metal/lab/cluster.env
#
# Shared, non-secret configuration for the bare-metal validation lab.
# Every value can be overridden by exporting it before running a script, e.g.
#   WORKERS=3 ./create-lab.sh
#
# See examples/bare-metal/lab/README.md and docs/infrastructure/bare-metal.md §8.

# ── Lab identity ──────────────────────────────────────────────────────────────
LAB_NAME="${LAB_NAME:-stellar-lab}"
LAB_NET="${LAB_NET:-stellar-lab-net}"
LAB_BRIDGE="${LAB_BRIDGE:-stellarlab0}"
LAB_DOMAIN="${LAB_DOMAIN:-stellar.lab}"
LAB_SUBNET="${LAB_SUBNET:-10.5.0.0/24}"
LAB_GATEWAY="${LAB_GATEWAY:-10.5.0.1}"
LAB_DHCP_START="${LAB_DHCP_START:-10.5.0.100}"
LAB_DHCP_END="${LAB_DHCP_END:-10.5.0.200}"

# VLAN used to prove 802.1Q isolation between nodes (see §6.3 / §8).
LAB_SCP_VLAN="${LAB_SCP_VLAN:-200}"
LAB_SCP_PREFIX="${LAB_SCP_PREFIX:-10.200.0}"
LAB_SCP_HOST_BASE="${LAB_SCP_HOST_BASE:-21}"

# All state lives outside the repository so the tree stays clean.
LAB_STATE_DIR="${LAB_STATE_DIR:-${HOME}/.cache/${LAB_NAME}}"

# ── Topology ──────────────────────────────────────────────────────────────────
CONTROLPLANES="${CONTROLPLANES:-3}"
WORKERS="${WORKERS:-2}"
VM_CPUS="${VM_CPUS:-2}"
VM_MEMORY_MB="${VM_MEMORY_MB:-4096}"
VM_ROOT_DISK_GB="${VM_ROOT_DISK_GB:-20}"
VM_DATA_DISK_GB="${VM_DATA_DISK_GB:-40}"

# First host address of control-plane and worker node IPs on LAB_SUBNET.
CP_IP_BASE="${CP_IP_BASE:-11}"
WORKER_IP_BASE="${WORKER_IP_BASE:-21}"

# ── Versions (pin everything; never track latest in CI) ───────────────────────
TALOS_VERSION="${TALOS_VERSION:-v1.8.2}"
LOCAL_PATH_VERSION="${LOCAL_PATH_VERSION:-v0.0.30}"
CILIUM_CHART="${CILIUM_CHART:-cilium/cilium}"

# ── Paths ─────────────────────────────────────────────────────────────────────
KUBECONFIG_PATH="${KUBECONFIG_PATH:-${LAB_STATE_DIR}/kubeconfig}"
TALOS_ISO_CACHE="${TALOS_ISO_CACHE:-${LAB_STATE_DIR}/iso}"
